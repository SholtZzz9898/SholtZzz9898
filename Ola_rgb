<!DOCTYPE html>
<html>
<head>
    <title>Olá RGB Animado!</title>
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #000;
            margin: 0;
            overflow: hidden;
            font-family: Arial, sans-serif;
        }
        h1 {
            font-size: 100px;
            font-weight: bold;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
            animation: rgbEffect 2s linear infinite;
        }
        @keyframes rgbEffect {
            0% { color: rgb(255, 0, 0); } /* Vermelho */
            25% { color: rgb(0, 255, 0); } /* Verde */
            50% { color: rgb(0, 0, 255); } /* Azul */
            75% { color: rgb(255, 255, 0); } /* Amarelo */
            100% { color: rgb(255, 0, 255); } /* Roxo */
        }
    </style>
</head>
<body>
    <h1>Olá</h1>
</body>
</html>
